{
  "compilerOptions": {
    "target": "ES2021",
    "module": "esnext",
    "lib": ["ES2021"],
    "outDir": "dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "paths": {
      "@routes/*": ["routes/*"],
      "@scrapers/*": ["scrapers/*"],
      "@lib/*": ["lib/*"],
      "@controllers/*": ["controllers/*"],
      "@typing/*": ["@types/*"],
      "@services/*": ["services/*"],
      "@validations/*": ["validations/*"],
      "@middleware/*": ["middleware/*"],
      "@models/*": ["models/*"],
      "@databases/*": ["databases/*"],
      "@external/*": ["external/*"]
    },
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}