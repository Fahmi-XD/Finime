generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  google_id String?  @default("")
  github_id String?  @default("")
  username  String?  @unique
  email     String?  @unique
  password  String?
  name      String?
  token     String?
  avatar    String?
  banner    String?
  pronoun   String?
  bio       String?
  isVerify  Boolean  @default(false)
  badges    String[]

  lastSeen DateTime? @default(now())

  anime    Anime[]
  manga    Manga[]
  comments Comment[]

  favorites Favorite[]
  history   AnimeHistory[]

  role Role @default(MEMBER)

  created_at DateTime  @default(now())
  updated_at DateTime? @map("updated_at")

  @@map("users")
}

model Anime {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  anime_id String

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.ObjectId

  created_at DateTime @default(now())

  @@map("anime")
}

model Manga {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  manga_id String

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.ObjectId

  created_at DateTime @default(now())

  @@map("manga")
}

model Comment {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  content String

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.ObjectId

  anime_id String?

  manga_id String?

  created_at DateTime @default(now())

  @@map("comments")
}

model Favorite {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  anime_id String?
  manga_id String?

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.ObjectId

  created_at DateTime @default(now())

  @@map("favorites")
}

model AnimeHistory {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title       String?
  cover       String?
  current_eps String?
  total_eps   String?
  anime_id    String?
  date        String?
  schedule    String?
  source      String?
  rating      String?

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.ObjectId

  updated_at DateTime? @default(now())
  created_at DateTime  @default(now())

  @@map("anime_histories")
}

enum Role {
  ADMIN
  MEMBER
  MODERATOR
}
