generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  google_id String?  @default("")
  github_id String?  @default("")
  username  String?   @unique
  email     String?  @unique
  password  String?
  name      String?
  token     String?
  avatar    String?
  banner    String?
  pronoun   String?
  bio       String?
  isVerify  Boolean  @default(false)
  badges    String[]

  lastSeen  DateTime? @default(now())

  anime    Anime[]
  manga    Manga[]
  comments Comment[]

  role Role @default(MEMBER)

  created_at DateTime  @default(now())
  updated_at DateTime? @map("updated_at")

  @@map("users")
}

model Anime {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  anime_id String

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.ObjectId

  created_at DateTime @default(now())

  @@map("anime")
}

model Manga {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  manga_id String

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.ObjectId

  created_at DateTime @default(now())

  @@map("manga")
}

model Comment {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  content String

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @db.ObjectId

  anime_id String?

  manga_id String?

  created_at DateTime @default(now())

  @@map("comments")
}

enum Role {
  ADMIN
  MEMBER
  MODERATOR
}
